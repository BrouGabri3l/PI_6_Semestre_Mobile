<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projeto_pi.Views.RecommendationPage"
             Title="RecommendationPage">
    <ScrollView>
        <Grid Padding="20" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Text="Recomendações" FontAttributes="Bold" FontSize="Medium" />
            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Recommendations}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="1" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Spacing="4">
                            <Image Source="{Binding HeaderImage}" HeightRequest="120" />
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Label Text="{Binding ShortDescription}" FontSize="Small" />
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </ScrollView>
</ContentPage>
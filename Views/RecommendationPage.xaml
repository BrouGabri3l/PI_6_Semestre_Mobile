<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projeto_pi.Views.RecommendationPage"
             Title="RecommendationPage">
    <StackLayout Padding="20" Spacing="10">
        <Label Text="Recomendações" FontAttributes="Bold" FontSize="Medium" />
        <CollectionView ItemsSource="{Binding Recommendations}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <StackLayout Spacing="4">
                        <Image Source="{Binding Image}" HeightRequest="120" />
                        <Label Text="{Binding Title}" FontAttributes="Bold" />
                        <Label Text="{Binding Description}" FontSize="Small" />
                    </StackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </StackLayout>
</ContentPage>
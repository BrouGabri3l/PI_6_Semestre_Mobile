<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projeto_pi.Views.QuizPage"
             Title="QuizPage">
    <StackLayout Padding="20" Spacing="10">
        <Label Text="{Binding CurrentQuestion.Text}" FontAttributes="Bold" FontSize="Medium" />
        <CollectionView ItemsSource="{Binding CurrentQuestion.Options}" RemainingItemsThreshold="2" RemainingItemsThresholdReached="OnRemainingItemsThresholdReached">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="5" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Source="{Binding Image}" HeightRequest="40" WidthRequest="40" Grid.Column="0" />
                        <Label Text="{Binding Text}" Grid.Column="1" />
                        <CheckBox IsChecked="{Binding IsSelected}" Grid.Column="2" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <Button Text="Próximo" Command="{Binding NextCommand}" />
    </StackLayout>
</ContentPage>